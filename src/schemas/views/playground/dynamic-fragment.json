{
  "id": "dynamic-fragment",
  "title": "Dynamic Fragment",
  "initialState": {
    "panel": {
      "open": false,
      "schemaId": null,
      "request": {
        "path": null,
        "query": {}
      }
    }
  },
  "dataSources": {},
  "actions": {
    "openSelectedPanel": {
      "type": "state.set",
      "target": "panel",
      "value": {
        "open": true,
        "schemaId": "$event.value",
        "request": {
          "path": "/api/ui/object-panels",
          "query": {
            "schema": "$event.value"
          },
          "method": "GET"
        }
      }
    },
    "openUserCreatePanel": {
      "type": "state.set",
      "target": "panel",
      "value": {
        "open": true,
        "schemaId": "user.create",
        "request": {
          "path": "/api/ui/users/create",
          "query": {},
          "method": "GET"
        }
      }
    },
    "openReportRunPanel": {
      "type": "state.set",
      "target": "panel",
      "value": {
        "open": true,
        "schemaId": "report.run",
        "request": {
          "path": "/api/ui/reports/run",
          "method": "POST",
          "body": {
            "contextId": "privileged-access"
          },
          "query": {}
        }
      }
    },
    "closePanel": {
      "type": "state.set",
      "target": "panel.open",
      "value": false
    },
    "openChangeReportRunPanel": {
      "type": "state.set",
      "target": "panel",
      "value": {
        "open": true,
        "schemaId": "report.run",
        "request": {
          "path": "/api/ui/reports/run",
          "method": "POST",
          "body": {
            "contextId": "gpo-changes"
          },
          "query": {}
        }
      }
    }
  },
  "root": {
    "id": "dynamic-page",
    "type": "page",
    "children": [
      {
        "id": "dynamic-title",
        "type": "title",
        "props": {
          "value": "Dynamic Fragment"
        }
      },
      {
        "id": "dynamic-objects-card",
        "type": "card",
        "props": {
          "title": "Dynamic schema panels",
          "description": "Choose an action or an object. Each action selects a schema and optional context."
        },
        "children": [
          {
            "id": "panel-launcher-actions",
            "type": "row",
            "props": {
              "gap": 8
            },
            "children": [
              {
                "id": "panel-launcher-new-user",
                "type": "button",
                "props": {
                  "label": "New user"
                },
                "handlers": {
                  "onClick": {
                    "action": "openUserCreatePanel"
                  }
                }
              },
              {
                "id": "panel-launcher-run-report",
                "type": "button",
                "props": {
                  "label": "Run report panel"
                },
                "handlers": {
                  "onClick": {
                    "action": "openReportRunPanel"
                  }
                }
              },
              {
                "id": "panel-launcher-actions-changes",
                "type": "button",
                "props": {
                  "label": "Run changes report"
                },
                "handlers": {
                  "onClick": {
                    "action": "openChangeReportRunPanel"
                  }
                }
              }
            ]
          },
          {
            "id": "dynamic-objects",
            "type": "generic-list",
            "props": {
              "label": "Demo objects",
              "items": [
                {
                  "id": "microsoft-365",
                  "title": "Microsoft 365",
                  "description": "Tenant settings · remote form"
                },
                {
                  "id": "active-directory",
                  "title": "Active Directory",
                  "description": "Directory health · remote tabs"
                },
                {
                  "id": "configuration",
                  "title": "Configuration",
                  "description": "Policy summary · remote cards"
                }
              ]
            },
            "bindings": {
              "selectedId": "$state.panel.schemaId"
            },
            "handlers": {
              "onSelect": {
                "action": "openSelectedPanel"
              }
            }
          }
        ]
      },
      {
        "id": "dynamic-schema-panel",
        "type": "side-panel",
        "props": {
          "title": "Dynamic schema panel",
          "description": "The initiating action supplies the schema request. The panel only hosts remote content."
        },
        "bindings": {
          "open": "$state.panel.open"
        },
        "handlers": {
          "onClose": {
            "action": "closePanel"
          }
        },
        "children": [
          {
            "id": "panel-switcher-actions",
            "type": "row",
            "props": {
              "gap": 8
            },
            "children": [
              {
                "id": "panel-switcher-new-user",
                "type": "button",
                "props": {
                  "label": "New user"
                },
                "handlers": {
                  "onClick": {
                    "action": "openUserCreatePanel"
                  }
                }
              },
              {
                "id": "panel-switcher-run-report",
                "type": "button",
                "props": {
                  "label": "Run report panel"
                },
                "handlers": {
                  "onClick": {
                    "action": "openReportRunPanel"
                  }
                }
              },
              {
                "id": "panel-switcher-actions-changes",
                "type": "button",
                "props": {
                  "label": "Run changes report"
                },
                "handlers": {
                  "onClick": {
                    "action": "openChangeReportRunPanel"
                  }
                }
              }
            ]
          },
          {
            "id": "panel-schema-label",
            "type": "text",
            "bindings": {
              "value": "$state.panel.schemaId"
            }
          },
          {
            "id": "panel-content",
            "type": "schema-outlet",
            "enabled": "$state.panel.open",
            "key": "$state.panel.schemaId",
            "source": {
              "request": "$state.panel.request",
              "definitionCache": "view"
            },
            "loading": {
              "id": "panel-loading",
              "type": "spinner",
              "props": {
                "label": "Loading panel schema..."
              }
            }
          }
        ]
      }
    ]
  }
}
